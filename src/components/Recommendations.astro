---
import { siteConfig } from "../config";
const hasRecommendations = siteConfig.recommendations && siteConfig.recommendations.length > 0;
---

{
  hasRecommendations && (
    <section id="recommendations" class="p-8 sm:p-12 md:p-16 lg:p-24">
      <div>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
          <div class="lg:col-span-4">
            <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-gray-900">
              Testimonial
            </h2>
            <div
              class="w-[75px] h-[5px] mt-2 rounded-full"
              style={`background-color: ${siteConfig.accentColor}`}
            />
          </div>

          <div class="lg:col-span-8">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
              {siteConfig.recommendations.map((rec) => (
                <div
                  class="relative bg-white rounded-lg border-2 p-4 sm:p-5 md:p-6 shadow-sm hover:shadow-md transition-all duration-300 hover:-translate-y-1"
                  style={`border-color: ${siteConfig.accentColor}`}
                >
                  {/* Decorative corner elements */}
                  <div
                    class="absolute top-2 left-2 w-3 h-3 border-t-2 border-l-2 rounded-tl"
                    style={`border-color: ${siteConfig.accentColor}`}
                  />
                  <div
                    class="absolute top-2 right-2 w-3 h-3 border-t-2 border-r-2 rounded-tr"
                    style={`border-color: ${siteConfig.accentColor}`}
                  />
                  <div
                    class="absolute bottom-2 left-2 w-3 h-3 border-b-2 border-l-2 rounded-bl"
                    style={`border-color: ${siteConfig.accentColor}`}
                  />
                  <div
                    class="absolute bottom-2 right-2 w-3 h-3 border-b-2 border-r-2 rounded-br"
                    style={`border-color: ${siteConfig.accentColor}`}
                  />

                  {/* Quote icon */}
                  <div class="mb-3">
                    <svg
                      class="w-6 h-6 sm:w-7 sm:h-7 opacity-30"
                      style={`color: ${siteConfig.accentColor}`}
                      fill="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.996 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.984zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h4v10h-10z" />
                    </svg>
                  </div>

                  {/* Recommendation text */}
                  <p class="text-sm sm:text-base text-gray-700 leading-relaxed mb-4 italic">
                    "{rec.text}"
                  </p>

                  {/* Author info */}
                  <div class="border-t pt-3 mt-3" style={`border-color: ${siteConfig.accentColor}`}>
                    <p class="text-sm sm:text-base font-semibold text-gray-900">{rec.name}</p>
                    <p class="text-xs sm:text-sm text-gray-600 mt-1">{rec.role}</p>
                    <p
                      class="text-xs sm:text-sm font-medium mt-1"
                      style={`color: ${siteConfig.accentColor}`}
                    >
                      {rec.company}
                    </p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}

